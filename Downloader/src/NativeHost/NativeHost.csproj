<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Downloader.NativeHost</AssemblyName>
    <RootNamespace>Downloader</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\Downloader\bin\$(Configuration)\net8.0-windows\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Downloader\Handoff.cs" Link="Handoff.cs" />
  </ItemGroup>

</Project>
