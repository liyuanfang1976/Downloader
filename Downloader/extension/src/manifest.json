{
  "manifest_version": 3,
  "name": "Downloader 接管",
  "version": "1.0.0",
  "description": "把浏览器下载交给本机 Downloader 接管",
  "key": "",
  "permissions": ["downloads", "cookies", "nativeMessaging"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Downloader 接管"
  }
}
